    "test:unit": "node --import tsx --test tests/time.test.ts"
  },
  "dependencies": {
    "@prisma/client": "6.12.0",
    "bcryptjs": "2.4.3",
    "next": "16.3.8",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "2.4.6",
    "@types/node": "22.18.6",
    "@types/react": "19.1.13",
    "@types/react-dom": "19.1.9",
    "prisma": "6.12.0",
    "tsx": "4.20.5",
    "typescript": "5.9.2"
  }
}
